{
  "name": "@kummie/brand",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KUMMIE design tokens (CSS + TS), self-hosted fonts, star and equaliser components.",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./brand.css": "./brand.css",
    "./fonts/*": "./fonts/*"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
