# apps/web — copy to .env.local (git-ignored) and adjust.
# Customer accounts call the API from the browser (cookie session on the API host). The shop and
# the API must be on the same site (kummie.eu / api.kummie.eu), and the API lists this shop
# in WEB_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional: address the web server itself uses for the API (catalogue pages are rendered on the
# server). On the hosting this can be a local address; defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
