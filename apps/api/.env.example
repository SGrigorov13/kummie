# apps/api — copy to apps/api/.env (git-ignored) and fill in the password.
#   Copy-Item apps/api/.env.example apps/api/.env
# In production (cPanel) set these in "Setup Node.js App" instead of a file.

# development | test | production  (cPanel sets production; pretty logs only in development)
NODE_ENV=development

# Port the API listens on (cPanel Passenger provides its own PORT).
PORT=3001
# 127.0.0.1 avoids the Windows firewall prompt locally.
HOST=127.0.0.1

# Local PostgreSQL 17 installed natively on Windows: database "kummie", user "postgres".
# Replace CHANGE_ME with the postgres user's password. URL-encode special characters
# in the password (e.g. @ → %40, # → %23, : → %3A, / → %2F).
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/kummie

# Small pool for shared hosting (max 10).
DB_POOL_MAX=5

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Staff API (admin panel). 32 random bytes, base64 — generate once per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse the production key anywhere else; losing it means staff must set up 2FA again.
STAFF_SECRET_KEY=

# Admin app origins allowed to call the staff API with cookies (comma-separated).
ADMIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Customer accounts: public shop address (used in e-mail links) and the shop origins allowed
# to call the account API with cookies. Production: WEB_URL=https://kummie.eu, WEB_ORIGINS=https://kummie.eu
WEB_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# E-mail: "file" writes every e-mail to MAIL_OUTBOX_DIR instead of sending it (development only —
# the files contain personal data). SMTP through Bulinfo follows in M1 Task 8.
EMAIL_TRANSPORT=file
MAIL_OUTBOX_DIR=mail-outbox

# Proxies whose X-Forwarded-For is trusted, so rate limits see the real client IP:
# false locally; on cPanel the number of proxies in front of Passenger (usually 1).
TRUST_PROXY=false

# Public base URL of uploaded product images.
MEDIA_BASE_URL=/media

# Folder with Drizzle SQL migrations, relative to apps/api.
MIGRATIONS_DIR=drizzle
